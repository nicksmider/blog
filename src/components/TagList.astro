---
interface Props {
  tags: string[]
  class?: string
}

const { tags, class: className } = Astro.props
---

<ul class:list={['flex flex-wrap gap-1.5', className]}>
  {tags.map((tag) => (
    <li>
      <a
        href={`/tags/${tag}`}
        class="rounded-full bg-neutral-100 px-2.5 py-0.5 font-mono text-xs text-neutral-600 transition-colors hover:bg-primary-100 hover:text-primary-700 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-primary-900/40 dark:hover:text-primary-300"
      >
        #{tag}
      </a>
    </li>
  ))}
</ul>
