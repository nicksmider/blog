---
interface Props {
  currentPage: number
  totalPages: number
  base: string
}

const { currentPage, totalPages, base } = Astro.props

const prev = currentPage > 1 ? (currentPage === 2 ? base : `${base}/${currentPage - 1}`) : null
const next = currentPage < totalPages ? `${base}/${currentPage + 1}` : null
---

{totalPages > 1 && (
  <nav class="mt-8 flex items-center justify-between">
    <div>
      {prev ? (
        <a
          href={prev}
          class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 px-4 py-2 font-mono text-sm text-neutral-600 transition-colors hover:border-primary-300 hover:text-primary-600 dark:border-neutral-800 dark:text-neutral-400 dark:hover:border-primary-700 dark:hover:text-primary-400"
        >
          ← Newer
        </a>
      ) : <div />}
    </div>

    <span class="font-mono text-xs text-neutral-400 dark:text-neutral-500">
      {currentPage} / {totalPages}
    </span>

    <div>
      {next ? (
        <a
          href={next}
          class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 px-4 py-2 font-mono text-sm text-neutral-600 transition-colors hover:border-primary-300 hover:text-primary-600 dark:border-neutral-800 dark:text-neutral-400 dark:hover:border-primary-700 dark:hover:text-primary-400"
        >
          Older →
        </a>
      ) : <div />}
    </div>
  </nav>
)}
