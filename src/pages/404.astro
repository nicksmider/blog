---
import Base from '@/layouts/Base.astro'
---

<Base title="404 — Page Not Found">
  <div class="mx-auto flex max-w-3xl flex-col items-center justify-center px-4 py-32 sm:px-6">
    <div class="w-full max-w-md rounded-xl border border-neutral-200 bg-neutral-50 p-8 dark:border-neutral-800 dark:bg-neutral-900/50">
      <p class="mb-4 font-mono text-xs text-neutral-400 dark:text-neutral-500">~/smider.dev</p>
      <p class="mb-1 font-mono text-sm">
        <span class="text-primary-500">❯</span>
        <span class="ml-2 text-neutral-500 dark:text-neutral-400">open <span class="text-neutral-900 dark:text-neutral-100">this-page</span></span>
      </p>
      <p class="mb-8 font-mono text-sm text-red-500 dark:text-red-400">
        error: no such file or directory (404)
      </p>
      <a
        href="/"
        class="font-mono text-sm text-primary-600 transition-colors hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
      >
        ← go home
      </a>
    </div>
  </div>
</Base>
