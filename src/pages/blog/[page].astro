---
import { getCollection } from 'astro:content'
import Base from '@/layouts/Base.astro'
import PostCard from '@/components/PostCard.astro'
import Pagination from '@/components/Pagination.astro'
import { SITE } from '@/config'

export async function getStaticPaths() {
  const allPosts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

  const totalPages = Math.ceil(allPosts.length / SITE.postsPerPage)

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
    props: {
      posts: allPosts.slice(i * SITE.postsPerPage, (i + 1) * SITE.postsPerPage),
      currentPage: i + 1,
      totalPages,
    },
  }))
}

const { posts, currentPage, totalPages } = Astro.props
---

<Base title={`Blog — Page ${currentPage}`}>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <div class="mb-10">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-50 px-3 py-1 font-mono text-xs text-neutral-500 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400">
        <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>
        ~/smider.dev/blog
      </div>
      <h1 class="text-4xl font-bold tracking-tight">Blog</h1>
    </div>

    <div class="flex flex-col gap-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination currentPage={currentPage} totalPages={totalPages} base="/blog" />
  </div>
</Base>
